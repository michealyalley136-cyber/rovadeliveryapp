# Copy to .env.staging; use a separate staging PostgreSQL database only.
DATABASE_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/STAGING_DATABASE?schema=public"
AUTH_SECRET="replace-with-a-unique-random-staging-secret-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="https://replace-with-your-staging-domain"
ROVA_PUBLIC_URL="https://replace-with-your-staging-domain"
ROVA_DEMO_MODE="false"
APPLICATIONS_ENABLED="true"
CUSTOMER_APPLICATIONS_ENABLED="true"
RIDER_APPLICATIONS_ENABLED="true"
DRIVER_APPLICATIONS_ENABLED="true"
DELIVERY_APPLICATIONS_ENABLED="true"
VEHICLE_ACCESS_ENABLED="true"
MERCHANT_APPLICATIONS_ENABLED="true"
FLEET_APPLICATIONS_ENABLED="true"
PARTNER_APPLICATIONS_ENABLED="true"
CUSTOMER_RIDES_ENABLED="false"
FOOD_ORDERING_ENABLED="false"
LIVE_DISPATCH_ENABLED="false"
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
ADMIN_ROLE="RECRUITMENT_AGENT"
ROVA_MAPTILER_PUBLIC_KEY=""
ROVA_GEOAPIFY_API_KEY=""
CUSTOMER_IDENTITY_DELIVERY_WEBHOOK_URL="https://replace-with-approved-identity-provider-webhook"
CUSTOMER_IDENTITY_DELIVERY_SECRET="replace-with-a-separate-staging-provider-secret-at-least-32-characters"
IDENTITY_NOTIFICATION_WORKER_URL="https://replace-with-your-staging-domain"
IDENTITY_NOTIFICATION_WORKER_SECRET="replace-with-a-separate-staging-worker-secret-at-least-32-characters"
IDENTITY_NOTIFICATION_ENCRYPTION_KEY_ID="v1"
IDENTITY_NOTIFICATION_ENCRYPTION_KEY="replace-with-a-32-byte-random-key-encoded-as-base64url"
