{
  "name": "rova-ghana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-maplibre-worker.mjs",
    "build": "prisma generate && next build",
    "prestart": "node scripts/prepare-maplibre-worker.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup:run": "node scripts/backup/backup.mjs",
    "backup:restore": "node scripts/backup/restore.mjs",
    "identity:notifications": "node scripts/process-identity-notifications.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "jose": "^5.9.6",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@prisma/config@7.10.1": {
      "effect": "3.22.1"
    }
  }
}
